<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
	Suite for running from the IDE (right-click → Run). Maven does not use this
	file; it runs every *Test class with the same settings (see pom.xml).
	The HTML report listener registers itself through META-INF/services,
	so it is not listed here (it would run twice).
	The "demo" group (ReportDemoTest: fails and skips on purpose) is left out,
	as in Maven; run ReportDemoTest directly to see it.
-->
<!-- The suite name becomes the report title; test classes run in parallel on 3 threads, one browser each -->
<suite name="OrangeHRM UI Suite" parallel="classes" thread-count="3">
	<!-- Read by TestNgFeaturesTest.titleMatchesTheSuiteParameter (@Parameters) -->
	<parameter name="expectedTitle" value="OrangeHRM" />
	<!-- One <test> block holding every test class -->
	<test name="OrangeHRM UI Tests">
		<!-- Group filter for this <test> -->
		<groups>
			<run>
				<!-- Leave out the demo tests (they fail and skip on purpose) -->
				<exclude name="demo" />
			</run>
		</groups>
		<!-- Run every test class in these packages -->
		<packages>
			<!-- Application tests on OrangeHRM -->
			<package name="com.automation.selenium.tests" />
			<!-- Interview examples, one sub-package per topic (".*" includes the sub-packages) -->
			<package name="com.automation.selenium.interview.*" />
		</packages>
	</test>
</suite>
